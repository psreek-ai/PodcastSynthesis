# =============================================================================
# AI Podcast Engine 2.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values you need.
# ALL variables are optional — the engine runs fully locally with zero API keys.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Leave blank to use local Ollama (free, private, no internet required).
# Set to your Anthropic API key to use Claude 3 Haiku (faster, cloud-based).
ANTHROPIC_API_KEY=

# --- Local LLM (Ollama) -----------------------------------------------------
# Set USE_LOCAL_LLM=true to force Ollama even if ANTHROPIC_API_KEY is set.
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Whisper Transcription ---------------------------------------------------
# Model sizes: tiny (39M), base (74M), small (244M), medium (769M), large (1.5B)
# Larger models are more accurate but slower. "base" is a good default.
WHISPER_MODEL=base

# --- AI Co-Host Voice --------------------------------------------------------
# Priority: ElevenLabs > Gemini Flash TTS > silent transitions
#
# Option 1: ElevenLabs (highest quality, 10k chars/month free)
# https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=TNQX694VP61R6o4D2n38
#
# Option 2: Google Gemini Flash TTS (free tier, no key required for basic use)
# Used automatically when ELEVENLABS_API_KEY is not set.
# Also powers LLM-based knowledge synthesis.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Spotify Integration -----------------------------------------------------
# Required for browsing your saved podcast library via /auth/spotify/start.
# Create an app at https://developer.spotify.com/dashboard
# Add http://localhost:8000/auth/spotify/callback as a Redirect URI.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# --- Knowledge Graph ---------------------------------------------------------
# Cosine distance threshold for "already known" detection (0.0 = identical, 1.0 = unrelated)
# Lower = stricter deduplication. Default 0.8 is a good starting point.
KNOWLEDGE_GRAPH_THRESHOLD=0.8
# Directory for ChromaDB persistent storage
CHROMA_DB_DIR=data/chroma_db

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Data Directories --------------------------------------------------------
# Relative to the backend/ directory
DATA_DIR=data
RAW_AUDIO_DIR=data/raw
FEED_DIR=data/feed
TTS_DIR=data/tts
VIRAL_DIR=data/viral
